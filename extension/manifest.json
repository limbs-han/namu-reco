{
  "manifest_version": 3,
  "name": "namu reco - 나무위키 개인화 추천",
  "version": "1.0.1",
  "description": "나무위키 열람 기록 기반 문서 추천",
  "minimum_chrome_version": "92",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["alarms"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    { "matches": ["*://namu.wiki/*"], "js": ["common.js", "content.js", "reco_tab.js", "related_box.js"] }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
